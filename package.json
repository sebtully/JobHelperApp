{
  "name": "jobpilot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run contract:emit && next build",
    "start": "next start",
    "lint": "eslint .",
    "contract:emit": "prisma contract emit",
    "db:init": "prisma contract emit && prisma db init --db \"$DATABASE_URL\"",
    "db:verify": "prisma db verify --db \"$DATABASE_URL\"",
    "db:plan": "prisma contract emit && prisma migration plan",
    "db:migrate": "prisma migrate --yes"
  },
  "dependencies": {
    "@prisma/orm-postgres": "^8.0.0-rc.8",
    "next": "16.3.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@tailwindcss/postcss": "^4.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.3",
    "postcss": "^8.5.0",
    "prisma": "^8.0.0-rc.12",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
